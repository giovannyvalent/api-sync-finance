# ---------------------------------------------------------------------------
# Projuris ADV
# Credenciais de API vêm do suporte Projuris (exige plano com acesso a API).
# ---------------------------------------------------------------------------
PROJURIS_AUTH_URL=https://apigw.projurisadv.com.br/auth/token
PROJURIS_API_URL=https://api.projurisadv.com.br/adv-service
PROJURIS_CLIENT_ID=
PROJURIS_CLIENT_SECRET=
# formato obrigatorio: USUARIO$$DOMINIO_ESCRITORIO (dominio em "Dados da conta")
PROJURIS_USERNAME=
PROJURIS_PASSWORD=

# CONFIRMAR com o suporte Projuris: a doc publica nao lista o modulo financeiro.
PROJURIS_LANCAMENTOS_PATH=/financeiro/lancamentos
PROJURIS_PARAM_DATA_INICIO=dataInicio
PROJURIS_PARAM_DATA_FIM=dataFim
PROJURIS_PARAM_PAGINA=pagina
PROJURIS_PARAM_TAMANHO_PAGINA=quantidadeRegistros
PROJURIS_TAMANHO_PAGINA=100
PROJURIS_MAX_PAGINAS=50

# ---------------------------------------------------------------------------
# Conta Azul (API v2)
# App criado no Portal do Desenvolvedor: https://developers.contaazul.com
# ---------------------------------------------------------------------------
CONTAAZUL_AUTH_BASE=https://auth.contaazul.com
CONTAAZUL_API_BASE=https://api-v2.contaazul.com/v1
CONTAAZUL_CLIENT_ID=
CONTAAZUL_CLIENT_SECRET=
CONTAAZUL_REDIRECT_URI=https://SEU-APP.vercel.app/oauth/contaazul/callback
CONTAAZUL_COMPANY_ID=default

# Preencher depois de rodar GET /sync/contaazul-refs
CONTAAZUL_CONTA_FINANCEIRA_ID=
CONTAAZUL_CATEGORIA_ID=
CONTAAZUL_CENTRO_CUSTO_ID=

# ---------------------------------------------------------------------------
# Supabase (idempotencia + tokens + analytics)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Operacao
# ---------------------------------------------------------------------------
SYNC_API_KEY=troque-por-uma-chave-forte
CRON_SECRET=troque-por-outra-chave-forte
SYNC_JANELA_DIAS=7
SYNC_VALOR_MINIMO=0.01
# lista separada por virgula; vazio = aceita qualquer status
SYNC_STATUS_PERMITIDOS=
# true = nunca escreve no Conta Azul (util no primeiro deploy)
SYNC_DRY_RUN=true
